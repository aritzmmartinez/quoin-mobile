      "name": "Instrument",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"Instrument\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"assetClass\" TEXT, \"quoteSymbol\" TEXT, \"exposureKind\" TEXT, \"exposureLeafId\" TEXT, \"ter\" TEXT, \"hedgedToBase\" INTEGER NOT NULL DEFAULT 0, \"thesis\" TEXT NOT NULL DEFAULT 'CORE' CHECK (thesis IN ('CORE', 'CONVICTION', 'TACTICAL')), \"createdAt\" TEXT NOT NULL, \"quoteSymbolHlc\" TEXT, \"exposureHlc\" TEXT, \"terHlc\" TEXT, \"hedgedToBaseHlc\" TEXT, \"thesisHlc\" TEXT);"
        }
      ]
    },
    {
      "name": "LedgerEntry",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"LedgerEntry\" (\"id\" TEXT NOT NULL PRIMARY KEY, \"ts\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"instrumentId\" TEXT REFERENCES Instrument(id)ON UPDATE CASCADE ON DELETE SET NULL, \"quantity\" TEXT, \"price\" TEXT, \"grossAmount\" TEXT NOT NULL, \"fees\" TEXT NOT NULL DEFAULT '0', \"taxWithheld\" TEXT NOT NULL DEFAULT '0', \"currency\" TEXT NOT NULL, \"fxSource\" TEXT NOT NULL DEFAULT 'IDENTITY' CONSTRAINT LedgerEntry_fxSource_check CHECK (fxSource IN ('IDENTITY', 'BROKER', 'ECB', 'MARKET', 'MANUAL')), \"fxDate\" TEXT, \"fxRate\" TEXT, \"fxDirection\" TEXT CONSTRAINT LedgerEntry_fxDirection_check CHECK (fxDirection IN ('QUOTE_PER_BASE', 'BASE_PER_QUOTE')), \"originalAmount\" TEXT, \"originalCurrency\" TEXT, \"valuationSource\" TEXT, \"linkId\" TEXT, \"linkKind\" TEXT, \"funding\" TEXT NOT NULL DEFAULT 'CASH' CONSTRAINT LedgerEntry_funding_check CHECK (funding IN ('CASH', 'IN_KIND')), \"account\" TEXT NOT NULL DEFAULT 'trade-republic', \"source\" TEXT NOT NULL DEFAULT 'MANUAL', \"externalId\" TEXT, \"note\" TEXT, \"createdAt\" TEXT NOT NULL, CONSTRAINT LedgerEntry_type_check CHECK(type IN ('BUY', 'SELL', 'DIVIDEND', 'DEPOSIT', 'WITHDRAWAL', 'INTEREST')));"
        }
      ]
