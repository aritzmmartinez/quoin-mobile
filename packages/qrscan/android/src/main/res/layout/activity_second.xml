<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_second"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <com.shinow.qrscan.ScanOverlayView
        android:id="@+id/scan_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/scan_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/scan_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/scan_glass_circle"
                android:contentDescription="@string/back"
                android:padding="12dp"
                android:src="@drawable/scan_ic_close" />

            <TextView
                android:id="@+id/scan_step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:gravity="center"
                android:textColor="@color/scan_text"
                android:textSize="15sp" />
        </FrameLayout>

        <Space
            android:id="@+id/scan_space_top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/scan_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/scan_side"
            android:layout_marginEnd="@dimen/scan_side"
            android:gravity="center"
            android:textColor="@color/scan_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/scan_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/scan_side"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/scan_side"
            android:gravity="center"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/scan_text_soft"
            android:textSize="14sp" />

        <!-- Where the overlay cuts the viewfinder; the activity sizes it. -->
        <View
            android:id="@+id/scan_hole"
            android:layout_width="@dimen/scan_hole"
            android:layout_height="@dimen/scan_hole"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/scan_searching_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="@dimen/scan_side"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="@dimen/scan_side"
            android:background="@drawable/scan_tag"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/scan_dot"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/scan_searching"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/scan_text_tag"
                android:textSize="13sp" />
        </LinearLayout>

        <Space
            android:id="@+id/scan_space_bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.4" />

        <LinearLayout
            android:id="@+id/scan_light_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="40dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/scan_light"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/scan_glass_circle"
                android:contentDescription="@string/torch"
                android:padding="17dp"
                android:src="@drawable/scan_ic_torch" />

            <TextView
                android:id="@+id/scan_light_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:textColor="@color/scan_text_faint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
